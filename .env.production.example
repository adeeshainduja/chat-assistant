# ==============================================================================
# GETMORE AI Assistant - Production Environment Configuration Template
# ==============================================================================
# Target Domain: https://ai.getmore.lk
# Deploy Path: Subdomain Document Root (e.g. public_html/ai/ or cPanel root)
#
# INSTRUCTIONS:
# 1. Copy this file to .env in your production cPanel root:
#    cp .env.production.example .env
# 2. Fill in your actual cPanel database credentials, API keys, and admin hash.
# 3. Ensure this file is never exposed publicly (.htaccess denies direct access).
# ==============================================================================

# Application Environment
APP_ENV=production
APP_URL=https://ai.getmore.lk
APP_DEBUG=false
DEV_MODE=false
APP_BASE_PATH=/
APP_TIMEZONE=Asia/Colombo

# AI Assistant Database (cPanel MySQL)
AI_DB_HOST=localhost
AI_DB_PORT=3306
AI_DB_NAME=CPANEL_DATABASE_NAME
AI_DB_USER=CPANEL_DATABASE_USER
AI_DB_PASSWORD=CPANEL_DATABASE_PASSWORD

# GETMORE Integration Mode (api = Production REST API)
GETMORE_DATA_MODE=api
GETMORE_API_BASE_URL=https://demo.getmore.lk
GETMORE_API_KEY=YOUR_GETMORE_API_KEY
GETMORE_API_AUTH_TYPE=x-api-key

# GETMORE API Endpoints
GETMORE_CLASSES_ENDPOINT=/api/v1/classes
GETMORE_LECTURERS_ENDPOINT=/api/v1/lecturers
GETMORE_EXTRA_CLASSES_ENDPOINT=/api/v1/extra-classes
GETMORE_ATTENDANCE_ENDPOINT=/api/v1/student/attendance/today

# Direct GETMORE Database (Optional / Fallback for attendance verification)
# Required ONLY if verified student attendance lookup is enabled and GETMORE API
# does not support direct student/parent phone authentication:
GETMORE_DB_HOST=localhost
GETMORE_DB_PORT=3306
GETMORE_DB_NAME=
GETMORE_DB_USER=
GETMORE_DB_PASSWORD=

# Gemini AI Service
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Security Encryption Key (Used for encrypting per-institute API keys in database)
# Generate a secure 32-character random string (e.g. using openssl rand -hex 16)
APP_ENCRYPTION_KEY=YOUR_SECURE_RANDOM_ENCRYPTION_KEY

# Admin Dashboard Authentication (https://ai.getmore.lk/admin/login.php)
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_PASSWORD_HASH

# Public Chat IP Rate Limiting
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60

# Attendance Verification Security
ATTENDANCE_MAX_ATTEMPTS=5
ATTENDANCE_BLOCK_SECONDS=600
ATTENDANCE_VERIFICATION_TTL=1800
