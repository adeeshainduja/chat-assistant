# GETMORE AI Assistant - Production Apache Configuration
# Configured for cPanel Subdomain Document Root: https://ai.getmore.lk

# Set directory index
DirectoryIndex index.php

# Prevent directory listing safely across Apache versions without triggering Options 500 errors
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# Block access to hidden files and directories (such as .git, .env)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# Protect sensitive files from direct web access
<FilesMatch "(^\.env.*$|^(composer\.(json|lock)|package(-lock)?\.json|README\.md|bootstrap\.php|DEPLOY_EXCLUDE\.txt|CPANEL_DEPLOYMENT\.md|\.gitignore)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Character encoding
AddDefaultCharset UTF-8
